# This .gitignore is for the PubStar Unity SDK (UPM package + Samples~/Driver demo).
# Patterns are NOT anchored to root so they also catch the nested sample projects
# (Samples~/ and Samples~/Driver/), which each generate their own Unity folders.

# === Unity generated folders (any level) ===
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]ser[Ss]ettings/
[Mm]emoryCaptures/
[Rr]ecordings/

# === Unity export / build junk ===
*_BurstDebugInformation_DoNotShip/
Android_BackUpThisFolder_ButDontShipItWithYourGame/
ExportedObj/
crashlytics-build.properties
sysinfo.txt
InitTestScene*.unity*
/[Aa]ssets/[Ii]nit[Tt]est[Ss]cene*.unity*

# === Accidental Unity project files at the package root & Samples~ root ===
# (the real demo lives in Samples~/Driver, whose ProjectSettings/Packages stay tracked)
/ProjectSettings/
/Packages/
/Samples~/ProjectSettings/
/Samples~/Packages/

# === Custom sample build outputs ===
/Samples~/BuildiOS/
/Samples~/BuildAndroid/
/Samples~/Frameworks/
/Samples~/output/

# === Native plugin build caches ===
**/PubStar.androidlib/build/
**/PubStar.androidlib/.gradle/

# === IDE / tooling ===
.vs/
.idea/
.gradle/
.consulo/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
*.DotSettings.user
mono_crash.*

# === Build artifacts ===
*.apk
*.aab
*.unitypackage
*.unitypackage.meta
*.app

# === Blender ===
*.blend1
*.blend1.meta

# === macOS ===
.DS_Store
**/.DS_Store
